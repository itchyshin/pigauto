> 
> ### ** Examples
> 
> set.seed(11)
> dat <- data.frame(
+   y = stats::rnorm(80),
+   x = stats::rnorm(80),
+   z = stats::rnorm(80)
+ )
> dat$x[seq(4, 80, by = 5)] <- NA_real_
> mi <- multi_impute_analysis(
+   dat, y ~ x + z, missing = "x", model = "lm", m = 5, seed = 12
+ )
> fits <- with_imputations(
+   mi, function(d) stats::lm(y ~ x + z, data = d), .progress = FALSE
+ )
